   "required": {
    "attested_forward": true
   },
   "conflicts": [
    "market_as_of != session"
   ]
  },
  "forward_observation_promoted": {
   "file": "research/archive/forward_observations_promoted.jsonl",
   "approval_capable": false,
   "why": "separate group; never production"
  },
  "forward_outcome": {
   "file": "research/archive/forward_outcomes.jsonl",
   "approval_capable": true,
   "required": {
    "eligible": true,
    "status": "matured"
   },
   "conflicts": [
    "eligible == true and status != 'matured'",
    "group != 'genuine_forward'"
   ]
  },
  "rule": {
   "file": "docs/research/source_rule_lifecycle.json#rules",
   "approval_capable": true,
   "required": {
