{
 "version": "kr-0.3.1-eligibility",
 "owner_approval_field": "owner_production_approval_id",
 "rule": "production_eligibility=true only if the kind is approval-capable AND every required flag is present, non-null, of the expected type and equal to the expected value AND no conflict rule fires AND owner_production_approval_id is a non-empty string. Otherwise false with exactly one reason code, first match in this order: type_never_eligible, missing_flag, null_flag, unknown_value, flag_conflict, value_mismatch, no_owner_approval.",
